# ============================================
# PostgreSQL Connection Settings
# ============================================
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE = fr

# ============================================
# API Settings
# ============================================
PACS_API_URL=http://localhost:5000
API_PORT=5000

# ============================================
# File Storage Paths
# ============================================
THUMBNAIL_PATH=./data/thumbnails
PERSON_PHOTOS_PATH=./data/person_photos

# ============================================
# Face Recognition Settings
# ============================================
EUCLIDEAN_THRESHOLD=0.6
UNKNOWN_THRESHOLD=0.8
MAX_FACES_IN_LIST=25
MIN_WIDTH_PHOTO=50

# ============================================
# Motion Detection Settings
# ============================================
MOTION_MIN_AREA=500
MOTION_THRESHOLD=25
MOTION_RECORD_AFTER_TIME=3

# ============================================
# Camera Settings
# ============================================
CAMERA_POLL_INTERVAL=5

# ============================================
# Debug Mode
# ============================================
DEBUG_MODE=false
SAVE_AVATARS=false