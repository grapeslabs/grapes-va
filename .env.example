# PostgreSQL
PG_USER=postgres
PG_PASSWORD=your_password
FR_DB=fr

# API
API_PORT=5000
DEBUG_MODE=false
PERSON_PHOTOS_PATH=/app/person_photos
MIN_WIDTH_PHOTO=50

# Core
PACS_API_URL=http://api:5000
THUMBNAIL_PATH=/app/thumbnails
CAMERA_POLL_INTERVAL=5
EUCLIDEAN_THRESHOLD=0.6
MAX_FACES_IN_LIST=25

# Motion detector defaults
MOTION_MIN_AREA=500
MOTION_THRESHOLD=25
MOTION_RECORD_AFTER_TIME=3