# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=fr

# API
PACS_API_URL=http://localhost:5000
API_PORT=5000

# Пути для хранения файлов
THUMBNAIL_PATH=
PERSON_AVATARS_PATH=
PHOTOS_PATH=./person_avatars

# Настройки распознавания
EUCLIDEAN_THRESHOLD=0.4
UNKNOWN_THRESHOLD=0.8
MAX_FACES_IN_LIST=25
MIN_WIDTH_PHOTO=80

# Настройки детектора движения
MOTION_MIN_AREA=500
MOTION_THRESHOLD=25
MOTION_RECORD_AFTER_TIME=3

# Настройки камер
CAMERA_POLL_INTERVAL=10
FACE_WIDTH_MAX=45
RESIZE=1
IS_DETECTION=true
IS_RECOGNIZE=true
CACHE_FACE_TIME=30
CACHE_FACE_MAX=20
DETECTION_FIGURE_ACTIVE=false
DETECTION_FIGURE_DIRECTION=LRBTA
WRITE_THUMBNAILS=false
WRITE_FRAME=false
TIMEDELAY=5

# Режим отладки
DEBUG_MODE=false
SAVE_PHOTOS=true

# ============================================
# Logging Settings (loglib)
# ============================================
LOGGING_TYPE=sentry
LOG_FILE=logs/app.log
LOG_BUFFER_ENABLED=false
LOG_BUFFER_FILE=logs/buffer.jsonl

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=docker_face@1.0.0
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_DEBUG=false
SENTRY_RETRY_ENABLED=true
SENTRY_RETRY_INTERVAL=5
SENTRY_MAX_RETRIES=3