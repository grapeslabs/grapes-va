FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libgl1  \
    libglx-mesa0 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN grep -Ev 'torch|ultralytics' requirements.txt > /tmp/requirements_filtered.txt && \
    pip install --no-cache-dir -r /tmp/requirements_filtered.txt

RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir --no-deps ultralytics

RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    matplotlib>=3.3.0 \
    opencv-python-headless>=4.6.0 \
    pillow>=7.1.2 \
    pyyaml>=5.3.1 \
    requests>=2.23.0 \
    scipy>=1.4.1 \
    tqdm>=4.64.0 \
    psutil \
    py-cpuinfo \
    numpy

COPY pacs_core.py .
COPY libs/ ./libs/
COPY pretrained/ ./pretrained/

CMD ["python", "pacs_core.py"]
